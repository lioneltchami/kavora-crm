# ─── Database (Supabase Postgres) ──────────────────────────────
# From Supabase: Settings → Database → Connection string (Transaction mode for serverless)
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
# Direct (non-pooled) URL for migrations
DIRECT_URL=postgresql://postgres:[password]@[host]:5432/postgres

# ─── Supabase (for Storage + pgvector) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[project].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Clerk Auth ─────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ─── Twilio ─────────────────────────────────────────────────────
# Account SID + Auth Token for the kavora-crm Twilio account.
# The same Auth Token verifies inbound webhook signatures.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Public base URL (used to build webhook URLs when provisioning numbers)
NEXT_PUBLIC_APP_URL=https://crm.kavora.systems

# ─── AI Providers ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-5

DEEPGRAM_API_KEY=...

# Embeddings (pick one provider)
VOYAGE_API_KEY=...
# OR
# OPENAI_API_KEY=sk-...

EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMS=1024

# ─── Trigger.dev ────────────────────────────────────────────────
TRIGGER_SECRET_KEY=tr_dev_...
TRIGGER_PROJECT_ID=proj_...

# ─── Observability ──────────────────────────────────────────────
SENTRY_DSN=...
NEXT_PUBLIC_SENTRY_DSN=...
SENTRY_AUTH_TOKEN=...

NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Outbound email (Phase 5+, optional) ────────────────────────
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=crm@kavora.systems

# ─── Misc ───────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
